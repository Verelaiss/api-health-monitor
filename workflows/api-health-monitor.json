        "query": "INSERT INTO alertas_monitoramento (\n    endpoint,\n    tipo_alerta,\n    quantidade_falhas,\n    mensagem,\n    historico_id\n)\nVALUES (\n    $1,\n    'FALHAS_CONSECUTIVAS',\n    3,\n    'API apresentou 3 falhas consecutivas',\n    $2\n)\nON CONFLICT (historico_id) DO NOTHING\nRETURNING *;",
        "options": {
