              "name": "classificacao",
              "value": "={{ $json.statusCode >= 200 && $json.statusCode < 300\n  ? 'SUCESSO_2XX'\n  : $json.statusCode >= 400 && $json.statusCode < 500\n  ? 'ERRO_CLIENTE_4XX'\n  : $json.statusCode >= 500 && $json.statusCode < 600\n  ? 'ERRO_SERVIDOR_5XX'\n  : 'OUTRO_STATUS'\n}}",
              "type": "string"
            },
            {
              "id": "bd1cbacb-68e5-43af-94d0-95108e48ebb6",
