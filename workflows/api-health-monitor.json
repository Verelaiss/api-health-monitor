        32
      ],
      "id": "79ea890e-457c-417c-ab12-b1ee8f901f17",
      "name": "Tempo resposta"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ultimas AS (\n    SELECT\n        id,\n        endpoint,\n        sucesso,\n        ROW_NUMBER() OVER (\n            PARTITION BY endpoint\n            ORDER BY id DESC\n        ) AS posicao\n    FROM public.historico_monitoramento\n   WHERE endpoint = $1\n),\nanalise AS (\n    SELECT\n        endpoint,\n        MAX(id) FILTER (\n            WHERE posicao = 1\n        ) AS historico_id,\n        COUNT(*) FILTER (\n            WHERE sucesso = FALSE\n              AND posicao < COALESCE(\n                  (\n                      SELECT MIN(u2.posicao)\n                      FROM ultimas u2\n                      WHERE u2.endpoint = u1.endpoint\n                        AND u2.sucesso = TRUE\n                  ),\n                  2147483647\n              )\n        ) AS falhas_consecutivas\n    FROM ultimas u1\n    GROUP BY endpoint\n)\nSELECT\n    endpoint,\n    historico_id,\n    falhas_consecutivas,\n    (falhas_consecutivas = 3) AS alerta\nFROM analise\nORDER BY endpoint;",
        "options": {
          "queryReplacement": "={{ [ $json.endpoint ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        -160,
        -80
      ],
      "id": "a2b351e8-3aea-403a-bcd0-1fd831c6c2bf",
      "name": "Verificar falhas"
